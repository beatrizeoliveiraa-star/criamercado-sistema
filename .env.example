# Copie para .env.local e preencha com os dados do projeto Supabase da CRIAMERCADO
# (Project Settings → API). Estas duas chaves são públicas por design;
# quem protege os dados são as permissões (RLS) no banco.
# NUNCA coloque aqui a service_role / secret key.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
